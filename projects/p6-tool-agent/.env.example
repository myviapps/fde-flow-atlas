# Copy to .env, fill in, then export these in your shell (see README).
# fake = offline rule-based model (default, no key needed); real = Anthropic API
LLM_MODE=fake
ANTHROPIC_API_KEY=your-key-here
# Any current Claude model id, for example claude-sonnet-5
MODEL=claude-sonnet-5
TRACE_FILE=trace.jsonl
