# fake = offline rule-based mode (default). real = call the Anthropic API.
LLM_MODE=fake
# Only needed when LLM_MODE=real. Never commit a real key.
ANTHROPIC_API_KEY=
# Model name from the Anthropic docs, for example a current Sonnet or Haiku model id.
MODEL=
# Max query rewrites before the graph gives up and refuses.
MAX_REWRITES=2
# Prices in USD per million tokens for the cost estimate. Copy from your provider's price sheet.
PRICE_IN_PER_MTOK=3.0
PRICE_OUT_PER_MTOK=15.0
