# fake = answer from the top chunk offline (default); real = Anthropic API
LLM_MODE=fake
ANTHROPIC_API_KEY=your-key-here
# Any current Claude model id, for example claude-sonnet-5
MODEL=claude-sonnet-5
# hash = offline hashing embedder (default); st = sentence-transformers
EMBED_MODE=hash
EMBED_MODEL=all-MiniLM-L6-v2
